# ============================================================
# LLM — choose ONE by setting MODEL (CrewAI routes via LiteLLM)
# ============================================================

# Option A: DeepSeek API (recommended — strong reasoning + reliable tool calling, very cheap)
#   Get a key at https://platform.deepseek.com
MODEL=deepseek/deepseek-chat
DEEPSEEK_API_KEY=

# Option B: Local open-source model via Ollama (free, runs on your PC)
#   Run `ollama serve` first. Models already on this machine: qwen3.5:9b, gemma4:12b
# MODEL=ollama/qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434

# Optional: lower = more factual, higher = more creative
TEMPERATURE=0.2

# ============================================================
# Web search for the Researcher + Review Analyst
#   Free key (2,500 searches) at https://serper.dev
# ============================================================
SERPER_API_KEY=
